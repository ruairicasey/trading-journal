{
  "name": "trading-journal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "prepare": "husky",
    "predev": "tsx scripts/db-setup.ts",
    "vercel-build": "tsx scripts/db-setup.ts && next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-setup.ts",
    "db:studio": "drizzle-kit studio",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "dev:demo": "tsx scripts/with-demo.ts dev -H 127.0.0.1",
    "sync:backfill": "tsx scripts/sync-backfill.ts",
    "verify:sync": "tsx scripts/verify-sync.ts",
    "debug:ordering": "tsx scripts/debug-ordering.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "gen-secret": "tsx scripts/gen-secret.ts",
    "test:e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@date-fns/tz": "^1.5.0",
    "@libsql/client": "^0.18.0",
    "@next/env": "^16.4.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.2",
    "jose": "^6.2.17",
    "lucide-react": "^1.70.0",
    "nanoid": "^6.0.2",
    "next": "15.5.29",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
