# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
# Placeholders only in this file.

# ── Data ────────────────────────────────────────────────────────
# All private data (SQLite DB, screenshots, exports, logs) lives here. Gitignored.
DATA_DIR=./data
# Local SQLite file by default. For a deployed instance set a Turso URL instead.
DATABASE_URL=file:./data/journal.db
# Turso auth token (deployed only; set in Vercel → Production scope only)
DATABASE_AUTH_TOKEN=

# ── App ─────────────────────────────────────────────────────────
APP_TIMEZONE=Australia/Melbourne

# ── Hyperliquid ────────────────────────────────────────────────
# Optional: read once on first run to create a wallet in Settings.
# A wallet address grants READ-ONLY access. Never put a private key anywhere.
HL_WALLET_ADDRESS=
HL_API_URL=https://api.hyperliquid.xyz

# ── Auth (required when deployed; optional locally) ────────────
# Set a password hash to require login locally too. In production login is ALWAYS required,
# and the app returns 503 on every route if these are missing (fails closed). See docs/deploy.md.
# Generate with: npm run hash-password
AUTH_PASSWORD_HASH=
# 32+ characters. Generate with: npm run gen-secret
AUTH_SECRET=
# Bearer token for /api/sync/cron (Vercel Cron + GitHub Actions). npm run gen-secret
CRON_SECRET=
# Per-request sync time budget (ms); keep under the host's function timeout
SYNC_BUDGET_MS=40000
# Budget for scheduled (cron) syncs; keep under maxDuration (300s on Vercel with Fluid compute)
CRON_SYNC_BUDGET_MS=240000

# ── Storage ────────────────────────────────────────────────────
# local (default) or r2
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Backups ────────────────────────────────────────────────────
# Must be OUTSIDE the repo. Defaults to ~/trading-journal-backups
BACKUP_DIR=
