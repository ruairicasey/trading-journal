{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test:e2e*)",
      "Bash(npm run build)",
      "Bash(npm run debug:*)",
      "Bash(npm run verify:sync*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git pull)",
      "Bash(git push origin main)",
      "Bash(gh run *)"
    ],
    "deny": [
      "Read(./.env*)",
      "Bash(cat .env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(*--no-verify*)"
    ]
  }
}
